{
  "name": "yana-web",
  "private": true,
  "version": "0.1.0",
  "description": "Browser client for YANA/. Preact and CodeMirror 6, built with esbuild and embedded into the yana binary.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@msgpack/msgpack": "^3.1.3",
    "preact": "^10.29.8",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.32"
  }
}
