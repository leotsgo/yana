# Copy to .env and edit. Every key is optional; the value shown is the default.
# Compose reads this file for the two host-side settings at the top and passes
# the YANA_* keys into the container.

# Host port to publish the UI on (compose only).
YANA_PORT=8080
# Host directory mounted at /notes (compose only). Created if missing.
YANA_DATA=./notes

# Directory that holds spaces. Inside the container this is always /notes.
# On bare metal the default is ~/.yana.
YANA_NOTES_ROOT=/notes
# Address the HTTP server binds to.
YANA_LISTEN=:8080
# debug, info, warn, or error.
YANA_LOG_LEVEL=info
# Optional YAML file read before the environment (same keys, snake_case).
#YANA_CONFIG=/notes/yana.yml

# Largest note the scanner will index, in bytes.
YANA_MAX_NOTE_SIZE=10485760
# Largest file under _assets/ the scanner will index, in bytes.
YANA_MAX_ASSET_SIZE=52428800
# Notes per space before new files are left unindexed.
YANA_MAX_NOTES_PER_SPACE=100000
# How long a file's mtime must be unchanged before it is assigned an id.
YANA_SCAN_SETTLE_TIME=2s

# Regex search through ripgrep when rg is on PATH.
YANA_RIPGREP=true
# Upper bound for one regex search.
YANA_RIPGREP_TIMEOUT=5s
