# Copy to .env and edit. Every key is optional; the value shown is the default.
# Compose reads this file for the two host-side settings at the top and passes
# the YANA_* keys into the container.

# Host port to publish the UI on (compose only).
YANA_PORT=8080
# Host directory mounted at /notes (compose only). Created if missing.
YANA_DATA=./notes

# Directory that holds spaces. Inside the container this is always /notes.
# On bare metal the default is ~/.yana.
YANA_NOTES_ROOT=/notes
# Address the HTTP server binds to.
YANA_LISTEN=:8080
# debug, info, warn, or error.
YANA_LOG_LEVEL=info
# Optional YAML file read before the environment (same keys, snake_case).
#YANA_CONFIG=/notes/yana.yml

# Largest note the scanner will index, in bytes.
YANA_MAX_NOTE_SIZE=10485760
# Largest file under _assets/ the scanner will index, in bytes.
YANA_MAX_ASSET_SIZE=52428800
# Notes per space before new files are left unindexed.
YANA_MAX_NOTES_PER_SPACE=100000
# How long a file's mtime must be unchanged before it is assigned an id, and
# how long the watcher waits before believing a file is empty or gone.
YANA_SCAN_SETTLE_TIME=2s
# Pause after the last edit before a note's document is written to its file.
YANA_WRITEBACK_IDLE=2s
# Window for collapsing bursts of filesystem events on one path.
YANA_WATCH_DEBOUNCE=200ms
# Per-note CRDT log length that triggers a snapshot.
YANA_COMPACT_AFTER=500
# How long the document of a deleted note is kept under .sync/crdt/retired.
YANA_CRDT_RETENTION=720h

# Regex search through ripgrep when rg is on PATH.
YANA_RIPGREP=true
# Upper bound for one regex search.
YANA_RIPGREP_TIMEOUT=5s

# Realtime relay (GET /ws). See docs/realtime.md for the protocol.
# Concurrent WebSocket connections.
YANA_WS_MAX_CONNECTIONS=256
# Note rooms one connection may subscribe to.
YANA_WS_MAX_ROOMS_PER_CONN=16
# Largest inbound frame, bytes.
YANA_WS_MAX_MESSAGE_BYTES=1048576
# Update and awareness messages per author per minute (users, agents). A
# client batching keystrokes on a 50ms timer peaks at 20 a second.
YANA_WS_USER_RATE=1200
YANA_WS_AGENT_RATE=300
# How often the server pings each connection to detect dead peers.
YANA_WS_PING_INTERVAL=30s
