<?xml version="1.0" encoding="utf-8"?>
<!-- A self-hosted server is often reached over plain HTTP on a home
     network or through the emulator's host alias, so cleartext is
     allowed; the server screen says so when an address uses it. User
     certificates are trusted so a server behind a private CA works. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
